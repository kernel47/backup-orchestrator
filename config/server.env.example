PREFECT_API_HOST=0.0.0.0
PREFECT_API_PORT=4200
# URL joignable depuis les satellites ET les navigateurs utilisant la UI.
PREFECT_SERVER_URL=http://prefect-server:4200
# Vide : .runtime/prefect/prefect.db ; sinon URL SQLite dans le dossier du projet.
PREFECT_DB_URL=
WORKER_CODE_PATH=/data/backup-orchestrator/worker
DEPLOYMENT_CONCURRENCY=1
JOBS_CRON=0 * * * *
POLICIES_CRON=0 2 * * *
IMAGES_CRON=0 3 * * *
SLP_CRON=0 4 * * *
SCHEDULE_TIMEZONE=UTC
PREFECT_SERVER_ANALYTICS_ENABLED=false
