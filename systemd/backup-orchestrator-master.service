[Unit]
Description=Backup Orchestrator master
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=backup-orchestrator
WorkingDirectory=/data/backup-orchestrator/master
ExecStart=/data/backup-orchestrator/master/venv/bin/python /data/backup-orchestrator/master/run.py master
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
