[Unit]
Description=Prefect server - Backup Orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=backup
Group=backup
WorkingDirectory=/data/backup-orchestrator/server
Environment=HOME=/data/backup-orchestrator/server/.runtime/home
Environment=PATH=/data/backup-orchestrator/server/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PREFECT_HOME=/data/backup-orchestrator/server/.runtime/prefect
Environment=TMPDIR=/data/backup-orchestrator/server/.runtime/tmp
ExecStart=/data/backup-orchestrator/server/venv/bin/python -m scripts.run_service server
StandardOutput=append:/data/backup-orchestrator/server/.runtime/logs/prefect-server.log
StandardError=inherit
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=3700
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
