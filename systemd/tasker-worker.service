[Unit]
Description=Tasker worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tasker
WorkingDirectory=/data/tasker
ExecStart=/data/tasker/.venv/bin/python /data/tasker/tasker.py worker
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
