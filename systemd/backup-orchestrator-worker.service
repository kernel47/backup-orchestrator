[Unit]
Description=Backup Orchestrator worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=backup-orchestrator
WorkingDirectory=/data/backup-orchestrator/app
ExecStart=/data/backup-orchestrator/app/.venv/bin/python /data/backup-orchestrator/app/run.py worker
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
