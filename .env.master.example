DATABASE_URL=sqlite:///var/orchestrator.db
# Or: DATABASE_URL=postgresql://orchestrator:password@127.0.0.1:5432/backup_orchestrator
# Used by the inventory synchronization CLI
MASTER_URL=http://127.0.0.1:8000
MASTER_HOST=127.0.0.1
MASTER_PORT=8000
# Local service log (relative to the project root), rotated at 10 MiB with 5 backups.
LOG_DIRECTORY=var/logs
LOG_LEVEL=INFO
# Dashboard credentials (master only)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Administrator API bearer token
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me
SCHEDULER_ENABLED=true
LEASE_SECONDS=30
OFFLINE_SECONDS=20
# Across all collectors/workers, keep one active collection per target host.
HOST_CONCURRENCY=1

WORKSPACE_NAME=Backup Orchestrator workspace
