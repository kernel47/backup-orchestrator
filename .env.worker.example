MASTER_URL=http://127.0.0.1:8000
WORKER_ID=EMEA-SAT-1
# Copy the one-time token generated by Configuration > Satellites.
WORKER_TOKEN=replace-with-provisioned-token
WORKER_CONCURRENCY=2
POLL_SECONDS=1
LEASE_SECONDS=30

# Optional: defaults to the worker OS timezone (IANA name, never the master timezone).
# WORKER_TIMEZONE=Europe/Paris
